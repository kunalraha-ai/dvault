# D-Vault — environment template (apps/web/.env)
# Copy this file to .env for local development.

# ── Database ─────────────────────────────────────────────────────────────
# Local development uses SQLite (zero setup). For production PostgreSQL:
#   1. In prisma/schema.prisma change provider to "postgresql"
#   2. Set DATABASE_URL="postgresql://user:password@host:5432/dvault"
DATABASE_URL="file:./dev.db"

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL of the web app (used by the extension and demo links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where client-encrypted document blobs are stored (relative to apps/web).
DVAULT_DATA_DIR=".data"

# ── Gnani.ai voice integration (REQUIRED for real voice, not the fallback) ─
# Get an API key: https://app.gnani.ai/voice/  →  API keys
# Contract: https://docs.gnani.ai  (see docs/GNANI_INTEGRATION.md)
# Without this key, D-Vault shows "Gnani.ai: not configured" and uses the
# clearly-labelled browser-speech fallback instead.
GNANI_API_KEY=""
# Optional overrides (defaults shown):
# GNANI_STT_URL="https://api.vachana.ai/stt/v3"
# GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"
# GNANI_STT_MODEL="prisma-v3.0"          # or prisma-v2.5
# GNANI_TTS_MODEL="timbre-v2.5"           # or timbre-v3.0
# GNANI_TTS_VOICE="Kaveri"               # e.g. Nalini (hi), Kaveri (en), Deepak
# GNANI_DEFAULT_LANGUAGE="en-IN"          # en-IN, hi-IN, hi-en, kn-IN, ta-IN, …
# GNANI_LANGUAGES="en-IN,hi-IN,hi-en,kn-IN,ta-IN,te-IN,ml-IN,mr-IN,bn-IN,gu-IN,pa-IN,indic-auto"

# ── Supabase — encrypted document storage + PostgreSQL database ──────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# When configured, document blobs (screenshots, receipts, uploaded files)
# are stored in Supabase Storage instead of the local filesystem.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="dvault-documents"  # (default)
#
# To also switch the DATABASE to Supabase PostgreSQL:
# 1. Get the connection string from: Supabase dashboard → Settings → Database
# 2. In prisma/schema.prisma change provider from "sqlite" to "postgresql"
# 3. Set DATABASE_URL to the Supabase Postgres connection string, then: npm run db:push
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ── AI-assisted field mapping — Kimi K2.7 (code) on Cloudflare Workers AI ───
# Optional. Without a token the deterministic on-device mapper is used.
# 1. Cloudflare dashboard → Workers AI → API → create an API token
# 2. Copy your Account ID (dashboard home, right sidebar)
# The adapter speaks Cloudflare's OpenAI-compatible endpoint automatically.
LLM_API_KEY=""
CF_ACCOUNT_ID=""
# Optional overrides (defaults shown):
# LLM_MODEL="@cf/moonshotai/kimi-k2.7-code"
# LLM_BASE_URL="https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1"
