# D-Vault — root environment template
#
# The web app reads its own env file: copy apps/web/.env.example → apps/web/.env
# This root template documents the complete variable surface in one place.

# ── Database (web app) ──────────────────────────────────────────────────────
# Local dev: SQLite (zero setup). Production: PostgreSQL.
DATABASE_URL="file:./dev.db"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DVAULT_DATA_DIR=".data"

# ── Gnani.ai voice (REQUIRED for real voice; empty → labelled fallback) ────
# Key from https://app.gnani.ai/voice/ · contract: https://docs.gnani.ai
GNANI_API_KEY=""
# GNANI_STT_URL="https://api.vachana.ai/stt/v3"
# GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"
# GNANI_STT_MODEL="prisma-v3.0"
# GNANI_TTS_MODEL="timbre-v2.5"
# GNANI_TTS_VOICE="Kaveri"
# GNANI_DEFAULT_LANGUAGE="en-IN"
# GNANI_LANGUAGES="en-IN,hi-IN,hi-en,kn-IN,ta-IN,te-IN,ml-IN,mr-IN,bn-IN,gu-IN,pa-IN,indic-auto"

# ── Supabase — encrypted document storage + PostgreSQL database ──────────
# Dashboard: https://supabase.com/dashboard → your project → Settings → API
# When configured: document blobs go to Supabase Storage (not local disk).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="dvault-documents"

# ── AI-assisted field mapping — Kimi K2.7 (code) on Cloudflare Workers AI ───
# Optional. Without a token the deterministic on-device mapper is used.
LLM_API_KEY=""
CF_ACCOUNT_ID=""
# LLM_MODEL="@cf/moonshotai/kimi-k2.7-code"
# LLM_BASE_URL="https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1"
